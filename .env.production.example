# ==============================================================================
# VERCEL PRODUCTION ENVIRONMENT TEMPLATE (PRD Section 9 & 12)
# ==============================================================================
# Gunakan template ini saat melakukan setup Environment Variables pada:
# 1. Project Vercel Frontend: `chenille-flowers-web` (Root: apps/web)
# 2. Project Vercel Backend:  `chenille-flowers-api` (Root: apps/api)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROJECT FRONTEND (`chenille-flowers-web` - apps/web)
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://chenille-flowers.vercel.app"

# API Route proxy destination (Rewrites ke Backend Serverless)
NEXT_PUBLIC_API_URL="https://chenille-flowers.vercel.app/api/v1"
INTERNAL_API_URL="https://chenille-flowers-api.vercel.app/api"

# Midtrans Client Key (Production atau Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
NEXT_PUBLIC_DEFAULT_THEME="tema-a"

# ------------------------------------------------------------------------------
# 2. PROJECT BACKEND (`chenille-flowers-api` - apps/api)
# ------------------------------------------------------------------------------
NODE_ENV="production"

# Supabase PostgreSQL Tokyo (Dual-URL Arsitektur - PRD 4.3)
# DATABASE_URL wajib menggunakan port 6543 (PgBouncer Connection Pooling)
DATABASE_URL="postgresql://postgres.wpdfxuwhqwvglqoiubfq:HtDqenaSKAmCdQGK@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL menggunakan direct connection port 5432 untuk Prisma Migrations
DIRECT_URL="postgresql://postgres.wpdfxuwhqwvglqoiubfq:HtDqenaSKAmCdQGK@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Domain CORS Frontend yang diizinkan
FRONTEND_URL="https://chenille-flowers.vercel.app"

# Kredensial Keamanan & Autentikasi
BETTER_AUTH_SECRET="your-production-secret-key-min-32-chars"
BETTER_AUTH_URL="https://chenille-flowers-api.vercel.app"
JWT_SECRET="your-production-jwt-secret-key-min-32-chars"

# Payment Gateway Midtrans
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="true"

# Logistik Aggregator Biteship
BITESHIP_API_KEY="your-biteship-api-key"

# WhatsApp Business Gateway (Fonnte API)
WA_GATEWAY_API_KEY="your-fonnte-api-key"
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_SENDER_DEVICE="081234567890"

# Geofencing Atelier Depok (Margonda Raya)
ATELIER_LATITUDE="-6.3728"
ATELIER_LONGITUDE="106.8315"
ATELIER_MAX_COD_RADIUS_KM="5.0"

# Cloud Storage Supabase Bucket (Upload Foto Buket & Bukti Garansi)
SUPABASE_URL="https://wpdfxuwhqwvglqoiubfq.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-jwt-token"
SUPABASE_STORAGE_BUCKET="product-images"
