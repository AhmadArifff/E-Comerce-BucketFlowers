// ==============================================================================
// CHENILLE ATELIER - PRISMA ORM SCHEMA
// Database: Supabase PostgreSQL (Dual URL: PgBouncer Pooler + Direct Migration)
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  FLORIST_STAFF
  CUSTOMER_MEMBER
}

enum ThemeKey {
  TEMA_A_KOREAN_PASTEL
  TEMA_B_MODERN_ROMANTIC
  TEMA_C_PLAYFUL_KAWAII
}

enum OrderFulfillment {
  COURIER_EXPEDITION
  COD_MEETUP_POINT
}

enum OrderStatus {
  WAITING_PAYMENT
  PAYMENT_CONFIRMED
  CRAFTING_BOUQUET
  QUALITY_CHECK_PASSED
  READY_FOR_DISPATCH
  ON_DELIVERY_EXPEDITION
  WAITING_AT_MEETUP_POINT
  COMPLETED
  CANCELLED
}

enum PaymentGatewayType {
  MIDTRANS_SNAP_QRIS
  MANUAL_BANK_BCA
  COD_CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  SETTLEMENT
  EXPIRED
  FAILED
  REFUNDED
}

enum WarrantyStatus {
  NONE
  SUBMITTED
  UNDER_REVIEW
  APPROVED_REPLACEMENT
  REJECTED
}

enum RawCategory {
  KAWAT_BULU
  CELLOPHANE_PAPER
  PITA_SATIN
  AKSESORI_BONEKA
  DRY_FOAM_FLORAL
  KARDUS_PACKAGING
  LEM_TEMBAK_GLUE
  OTHER_MATERIALS
}

enum ProcurementStatus {
  DRAFT
  ORDERED
  ON_SHIPPING
  ARRIVED
  CANCELLED
}

enum WasteReason {
  DAMAGED_IN_STORAGE
  RUSTED_WIRE
  TORN_CELLOPHANE
  PRODUCTION_MISTAKE
  LOW_QUALITY_SUPPLIER
  SAMPLE_DISPLAY_EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CustomCategory {
  FLOWER_TYPE
  CHENILLE_COLOR
  WRAPPING_STYLE
  RIBBON_STYLE
  PACKAGING_BOX
  GREETING_SEAL
  ACCESSORY_ADDON
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  password_hash String
  role          Role      @default(CUSTOMER_MEMBER)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  profile       Profile?
  addresses     UserAddress[]
  orders        Order[]
  chat_sessions ChatSession[]
  reviews       ProductReview[]
  saved_designs SavedCustomDesign[]

  @@index([role])
}

model Profile {
  id              String    @id
  user            User      @relation(fields: [id], references: [id], onDelete: Cascade)
  full_name       String
  avatar_url      String?
  preferred_theme ThemeKey  @default(TEMA_A_KOREAN_PASTEL)
  flower_points   Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model UserAddress {
  id             String   @id @default(uuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipient_name String
  phone_number   String
  full_address   String
  city           String   @default("Depok")
  postal_code    String?
  is_default     Boolean  @default(false)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  created_at     DateTime @default(now())

  @@index([user_id])
}

model Category {
  id          String    @id
  name        String
  slug        String    @unique
  description String?
  icon_name   String?
  products    Product[]
}

model Product {
  id                String            @id
  name              String
  slug              String            @unique
  category_id       String?
  category          Category?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  price             Decimal           @db.Decimal(10, 2)
  discount_price    Decimal?          @db.Decimal(10, 2)
  raw_cost_hpp      Decimal           @db.Decimal(10, 2)
  stock             Int               @default(10)
  po_lead_days      Int               @default(0)
  click_count       Int               @default(0)
  is_ready_stock    Boolean           @default(true)
  is_active         Boolean           @default(true)
  badge             String?
  rating            Decimal           @default(5.0) @db.Decimal(3, 2)
  review_count      Int               @default(0)
  description       String?           @db.Text
  image_url         String
  theme_suitability String[]          @default(["tema-a"])
  colors            String[]          @default(["#FCA5A5"])
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  images            ProductImage[]
  bom_recipes       BillOfMaterial[]
  order_items       OrderItem[]
  reviews           ProductReview[]

  @@index([category_id])
  @@index([is_active])
  @@index([slug])
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image_url  String
  is_primary Boolean  @default(false)
  sort_order Int      @default(0)

  @@index([product_id])
}

model SupplierDirectory {
  id               String             @id @default(uuid())
  name             String
  pic_name         String?
  phone            String
  address          String?
  marketplace_link String?
  terms_notes      String?
  rating           Decimal?           @default(4.9) @db.Decimal(3, 2)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())

  raw_materials    RawMaterial[]
  procurements     ProcurementOrder[]
}

model RawMaterial {
  id               String               @id
  name             String
  category         RawCategory
  stock            Int                  @default(100)
  min_stock        Int                  @default(20)
  unit             String
  cost_per_unit    Decimal              @db.Decimal(10, 2)
  supplier_id      String?
  supplier         SupplierDirectory?   @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  supplier_name    String
  supplier_contact String
  supplier_link    String?
  notes            String?
  updated_at       DateTime             @updatedAt

  bom_recipes      BillOfMaterial[]
  procurements     ProcurementOrder[]
  waste_logs       WasteMaterialLog[]

  @@index([category])
}

model BillOfMaterial {
  id              String       @id @default(uuid())
  product_id      String
  product         Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  raw_material_id String
  raw_material    RawMaterial  @relation(fields: [raw_material_id], references: [id], onDelete: Restrict)
  quantity_needed Int
  subtotal_cost   Decimal      @db.Decimal(10, 2)

  @@index([product_id])
  @@index([raw_material_id])
}

model ProcurementOrder {
  id                String             @id
  material_id       String
  material          RawMaterial        @relation(fields: [material_id], references: [id], onDelete: Restrict)
  material_name     String
  supplier_id       String?
  supplier          SupplierDirectory? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  supplier_name     String
  supplier_contact  String?
  supplier_link     String?
  order_date        DateTime           @default(now())
  estimated_arrival DateTime
  actual_arrival    DateTime?
  qty_ordered       Int
  unit              String
  cost_per_unit     Decimal            @db.Decimal(10, 2)
  total_cost        Decimal            @db.Decimal(12, 2)
  status            ProcurementStatus  @default(ORDERED)
  tracking_number   String?
  is_stock_added    Boolean            @default(false)
  notes             String?
  created_at        DateTime           @default(now())

  @@index([material_id])
  @@index([status])
}

model WasteMaterialLog {
  id                String       @id @default(uuid())
  material_id       String?
  material          RawMaterial? @relation(fields: [material_id], references: [id], onDelete: SetNull)
  material_name     String
  category          RawCategory
  qty               Int
  unit              String
  cost_per_unit     Decimal      @db.Decimal(10, 2)
  total_loss        Decimal      @db.Decimal(12, 2)
  reason            WasteReason
  mitigation_action String?
  reported_at       DateTime     @default(now())

  @@index([category])
  @@index([reported_at])
}

model CodMeetupPoint {
  id             String   @id
  name           String
  full_address   String
  google_maps_url String
  distance_km    Decimal  @db.Decimal(4, 1)
  delivery_notes String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  radius_meters  Int      @default(500)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  orders         Order[]
}

model CustomStudioOption {
  id             String         @id
  category       CustomCategory
  name           String
  description    String?
  price_modifier Decimal        @default(0) @db.Decimal(10, 2)
  emoji_or_icon  String?
  hex_color      String?
  sort_order     Int            @default(0)
  is_active      Boolean        @default(true)

  @@index([category])
  @@index([is_active])
}

model SavedCustomDesign {
  id                   String   @id @default(uuid())
  user_id              String?
  user                 User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  design_name          String
  flower_type_id       String?
  chenille_color_id    String?
  wrapping_style_id    String?
  ribbon_style_id      String?
  packaging_box_id     String?
  greeting_seal_id     String?
  addon_ids            String[] @default([])
  calculated_total     Decimal  @db.Decimal(10, 2)
  preview_snapshot_url String?
  created_at           DateTime @default(now())

  @@index([user_id])
}

model Coupon {
  id                String       @id
  code              String       @unique
  discount_type     DiscountType
  discount_value    Decimal      @db.Decimal(10, 2)
  min_order_amount  Decimal      @default(0) @db.Decimal(10, 2)
  quota             Int          @default(100)
  used_count        Int          @default(0)
  is_active         Boolean      @default(true)
  expires_at        DateTime?
  orders            Order[]

  @@index([code])
}

model Order {
  id                     String             @id
  user_id                String?
  user                   User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name          String
  customer_phone         String
  customer_email         String
  recipient_name         String
  fulfillment_type       OrderFulfillment
  shipping_address       String?
  cod_meetup_id          String?
  cod_meetup_point       CodMeetupPoint?    @relation(fields: [cod_meetup_id], references: [id], onDelete: SetNull)
  cod_notes              String?
  total_amount           Decimal            @db.Decimal(12, 2)
  discount_amount        Decimal            @default(0) @db.Decimal(10, 2)
  coupon_id              String?
  coupon                 Coupon?            @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  total_hpp_cost         Decimal            @db.Decimal(12, 2)
  payment_method         PaymentGatewayType
  payment_status         PaymentStatus      @default(UNPAID)
  order_status           OrderStatus        @default(WAITING_PAYMENT)
  current_step           Int                @default(1)
  courier_name           String?
  tracking_number        String?
  warranty_status        WarrantyStatus     @default(NONE)
  warranty_claim_reason  String?
  warranty_evidence_url  String?
  theme_used             ThemeKey           @default(TEMA_A_KOREAN_PASTEL)
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  items                  OrderItem[]
  status_histories       OrderStatusHistory[]
  transactions           PaymentTransaction[]
  reviews                ProductReview[]

  @@index([user_id])
  @@index([customer_phone])
  @@index([customer_email])
  @@index([order_status])
}

model OrderItem {
  id                String   @id @default(uuid())
  order_id          String
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id        String?
  product           Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name      String
  price             Decimal  @db.Decimal(10, 2)
  raw_cost_hpp      Decimal  @db.Decimal(10, 2)
  quantity          Int      @default(1)
  subtotal          Decimal  @db.Decimal(12, 2)
  custom_specs_json Json?

  @@index([order_id])
}

model OrderStatusHistory {
  id              String   @id @default(uuid())
  order_id        String
  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  step_number     Int
  status_title    String
  status_desc     String
  photo_proof_url String?
  action_by       String?
  created_at      DateTime @default(now())

  @@index([order_id])
}

model PaymentTransaction {
  id                  String             @id
  order_id            String
  order               Order              @relation(fields: [order_id], references: [id], onDelete: Cascade)
  gateway_type        PaymentGatewayType
  amount              Decimal            @db.Decimal(12, 2)
  status              PaymentStatus      @default(UNPAID)
  snap_token          String?
  payment_url         String?
  bca_va_number       String?
  qr_code_url         String?
  paid_at             DateTime?
  raw_webhook_payload Json?
  created_at          DateTime           @default(now())

  @@index([order_id])
  @@index([status])
}

model ProductReview {
  id                String   @id @default(uuid())
  order_id          String
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user_id           String?
  user              User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name     String
  rating            Int
  comment           String   @db.Text
  photo_url         String?
  is_verified_buyer Boolean  @default(true)
  is_published      Boolean  @default(true)
  created_at        DateTime @default(now())

  @@index([product_id])
}

model ChatSession {
  id               String        @id
  user_id          String?
  user             User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  guest_name       String
  guest_email      String?
  is_escalated_wa  Boolean       @default(false)
  is_active        Boolean       @default(true)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  messages         ChatMessage[]

  @@index([is_active])
}

model ChatMessage {
  id             String      @id @default(uuid())
  session_id     String
  session        ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  sender         String
  text           String      @db.Text
  attachment_url String?
  sent_at        DateTime    @default(now())

  @@index([session_id])
}

model CannedResponse {
  id              String   @id @default(uuid())
  trigger_keyword String
  title           String
  message_text    String   @db.Text
  category        String   @default("FAQ")
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)

  @@index([trigger_keyword])
}

model StoreSetting {
  id                  String   @id @default("atelier_setting")
  store_name          String   @default("Chenille Atelier Depok")
  tagline             String   @default("Buket Bunga Kawat Bulu Chenille Premium & Graduation Florist")
  official_whatsapp   String   @default("+62 812-9831-7721")
  studio_address      String   @default("Jl. Margonda Raya No. 120, Beji, Kota Depok, Jawa Barat 16424")
  daily_po_limit      Int      @default(25)
  active_theme        ThemeKey @default(TEMA_A_KOREAN_PASTEL)
  is_maintenance_mode Boolean  @default(false)
  maintenance_title   String   @default("Atelier Chenille Sedang Istirahat Produksi")
  maintenance_desc    String   @default("Kapasitas buket wisuda hari ini telah penuh.")
  updated_at          DateTime @updatedAt
}

model PaymentGatewayConfig {
  id               String             @id @default(uuid())
  gateway_type     PaymentGatewayType @unique
  is_enabled       Boolean            @default(true)
  credentials_json Json?
  admin_fee        Decimal            @default(0) @db.Decimal(10, 2)
  max_distance_km  Decimal?           @db.Decimal(4, 1)
  notes            String?            @db.Text
  updated_at       DateTime           @updatedAt
}

model FeatureToggle {
  key         String   @id
  name        String
  description String
  is_enabled  Boolean  @default(true)
  updated_at  DateTime @updatedAt
}
