{
  "name": "e-commerce-bucket-flowers",
  "private": true,
  "version": "2.2.0",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=chenille-flowers-web",
    "dev:api": "npm run dev --workspace=@chenille/api",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=chenille-flowers-web",
    "build:api": "npm run build --workspace=@chenille/api",
    "build:shared": "npm run build --workspace=@chenille/shared",
    "kill:port": "npx -y kill-port 3000 4000",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "prisma:generate": "npm run prisma:generate --workspace=@chenille/api",
    "prisma:push": "npm run prisma:push --workspace=@chenille/api",
    "test": "npm run test --workspace=@chenille/api",
    "test:unit": "npm run test:unit --workspace=@chenille/api",
    "test:integration": "npm run test:integration --workspace=@chenille/api",
    "test:e2e": "npm run test:e2e --workspace=@chenille/api",
    "clean": "turbo run clean"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
